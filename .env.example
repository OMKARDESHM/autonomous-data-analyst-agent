OPENAI_API_KEY=
OPENAI_MODEL=gpt-3.5-turbo

# Example PostgreSQL URL (used when not uploading a local SQLite DB):
DATABASE_URL=postgresql+psycopg2://username:password@host:5432/database

# Optional: simple token to protect the Streamlit UI
STREAMLIT_AUTH_TOKEN=your_secret_token

# Optional: folder to persist uploaded datasets (default: system temp dir)
UPLOADS_DIR=./uploads