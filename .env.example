# ── NVIDIA NIM (primary LLM) ─────────────────────────────────────────────────
NVIDIA_API_KEY=nvapi-your-key-here
MODEL_NAME=meta/llama-3.1-8b-instruct

# ── OpenAI (optional fallback LLM) ───────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-3.5-turbo

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL (default target):
DATABASE_URL=postgresql+psycopg2://username:password@host:5432/salesdb

# ── Streamlit Auth ────────────────────────────────────────────────────────────
# Option A — simple token-based auth (set one secret token):
STREAMLIT_AUTH_TOKEN=your_secret_token

# Option B — JWT-based login form (set all three):
JWT_SECRET=your_jwt_secret
AUTH_USER=admin
AUTH_PASS=password

# ── Upload storage ────────────────────────────────────────────────────────────
# Folder to persist uploaded datasets (default: system temp dir)
UPLOADS_DIR=./uploads